APP_ENV=development
EXPO_PUBLIC_API_ORIGIN=https://your-workspace.example
# Production OTA requires all three, otherwise OTA stays disabled.
DUALLANE_UPDATES_URL=
DUALLANE_UPDATE_CERTIFICATE=
DUALLANE_UPDATE_KEY_ID=
# Signing for scripts/build-android.mjs; never commit private signing files.
DUALLANE_ANDROID_KEYSTORE=
DUALLANE_ANDROID_KEY_ALIAS=
DUALLANE_ANDROID_STORE_PASSWORD=
DUALLANE_ANDROID_KEY_PASSWORD=
